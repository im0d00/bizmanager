# Frontend Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel dashboard for production deployment

# API URL - Use your backend deployment URL
# Leave empty for local development (uses Vite proxy to http://localhost:5000)
# For production, set this to your backend URL (e.g., Railway, Render, etc.)
# Example: VITE_API_URL=https://your-backend.up.railway.app/api
VITE_API_URL=
